# ==============================================================================
# SIGNALFIRE AI - Environment Configuration
# ==============================================================================

# --- Analytical Storage: Exasol Personal ---
# If Exasol is running, configure connection credentials below.
# If omitted or unreachable, SIGNALFIRE AI will transparently use DuckDB Local.
EXASOL_DSN=localhost:8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=SIGNALFIRE
EXASOL_TIMEOUT=5

# --- Local Fallback Database Engine ---
DUCKDB_PATH=signalfire_local.duckdb

# --- Application Server Settings ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Anomaly Detection Sensitivity Defaults ---
ROBUST_Z_THRESHOLD=2.50
IQR_MULTIPLIER=1.75
PERCENT_DELTA_THRESHOLD=0.35

# --- Optional AI Assistant Credentials ---
# When omitted, the assistant operates in Deterministic Analytical Tool Mode
# with zero numerical hallucinations.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
